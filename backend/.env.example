# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://sqlquery_user:sqlquery_pass@localhost:5432/sqlquery_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sqlquery_db
DB_USER=sqlquery_user
DB_PASSWORD=sqlquery_pass

# JWT Authentication
# Generate a strong secret key: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# Encryption Key (AES-256)
# MUST be exactly 32 characters for AES-256
# Generate: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY=your-32-character-encryption-key

# Redis Configuration (for job queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notification Settings
NOTIFICATION_FROM_EMAIL=noreply@sqlpulse.com
NOTIFICATION_FROM_NAME=SQLPulse Notifications

# Slack Integration (optional)
SLACK_WEBHOOK_URL=

# Microsoft Teams Integration (optional)
TEAMS_WEBHOOK_URL=

# Discord Integration (optional)
DISCORD_WEBHOOK_URL=

# Application Settings
APP_NAME=SQLPulse
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Security Settings
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/
