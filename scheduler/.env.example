# Scheduler Service Configuration
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://sqlquery_user:sqlquery_pass@localhost:5432/sqlquery_db

# Encryption Key (AES-256) - MUST match backend
# MUST be exactly 32 characters for AES-256
ENCRYPTION_KEY=your-32-character-encryption-key

# Redis Configuration (for Bull queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Queue Settings
QUEUE_NAME=query-execution-queue
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT=600000
MAX_RETRIES=3
BACKOFF_DELAY=5000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notification Settings
NOTIFICATION_FROM_EMAIL=noreply@sqlpulse.com
NOTIFICATION_FROM_NAME=SQLPulse Scheduler

# Slack Integration (optional)
SLACK_WEBHOOK_URL=

# Microsoft Teams Integration (optional)
TEAMS_WEBHOOK_URL=

# Discord Integration (optional)
DISCORD_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/scheduler.log

# Scheduler Settings
CRON_CHECK_INTERVAL=60000
ENABLE_JOB_LOGGING=true
KEEP_COMPLETED_JOBS=100
KEEP_FAILED_JOBS=500

# Performance Settings
QUERY_TIMEOUT=300000
MAX_RESULT_SIZE=10000000
